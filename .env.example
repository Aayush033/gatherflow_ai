# GatherFlow AI — Environment Configuration Template
# Copy this file to .env and configure your secrets

# Google Gemini API Key (Server-side secret)
GEMINI_API_KEY=your_gemini_api_key_here

# Main Model (gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Environment (development or production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Evaluator Passcode (used to access dedicated evaluator session)
EVALUATOR_PASSCODE=gatherflow-evaluator

# Session Security Secret
SESSION_SECRET_KEY=change_this_to_a_random_secret_in_production
